# Copy to .env and fill in. .env is gitignored.
# For EAS cloud builds, set the same names with `eas env:create`.

# RevenueCat public SDK keys (Project settings > API keys). Safe to ship in the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob production banner ad unit. If empty, the app shows Google test ads.
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=

# AdMob app ID, read by app.config.js at build time. If empty, Google's sample ID is used.
ADMOB_IOS_APP_ID=
